{
  "lineWidth": 100,
  "indentWidth": 2,
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "preferDouble",
    "trailingCommas": "onlyMultiLine",
    "arrowFunction.useParentheses": "force",
    "conditionalType.layout": "staircase",
    "functionExpression.spaceBeforeParentheses": true,
    "operatorPosition": "sameLine",
    "module.sortImportDeclarations": "maintain",
    "module.sortExportDeclarations": "maintain",
    "importDeclaration.sortNamedImports": "maintain",
    "exportDeclaration.sortNamedExports": "maintain"
  },
  "excludes": [
    "fixtures/**",
    "dist/**",
    "**/node_modules",
    "pnpm-lock.yaml",
    "**/*.snap"
  ],
  "plugins": [
    "https://github.com/saiashirwad/dprint-staircase-ternaries/releases/download/0.96.1-staircase.2/dprint_staircase_ternaries.wasm",
    "https://plugins.dprint.dev/json-0.24.0.wasm",
    "https://plugins.dprint.dev/markdown-0.24.0.wasm"
  ]
}
