{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/Application.ts",
    "src/Draft/index.ts",
    "src/Node.ts",
    "src/Plan.ts",
    "src/Policy.ts",
    "src/Query/index.ts",
    "src/Recipe.ts",
    "src/Verification/index.ts",
    "src/Workspace/index.ts",
    "tools/*.mjs"
  ],
  "project": ["src/**/*.ts", "tools/**/*.mjs"],
  "ignoreExportsUsedInFile": true
}
