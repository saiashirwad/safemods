{
  "name": "safemods",
  "version": "0.2.0",
  "description": "Type-directed codemods for TypeScript 7+ projects, built on Effect.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./Check": {
      "source": "./src/Check.ts",
      "types": "./dist/src/Check.d.ts",
      "default": "./dist/src/Check.js"
    },
    "./Checks": {
      "source": "./src/Checks/index.ts",
      "types": "./dist/src/Checks/index.d.ts",
      "default": "./dist/src/Checks/index.js"
    },
    "./Config": {
      "source": "./src/Config.ts",
      "types": "./dist/src/Config.d.ts",
      "default": "./dist/src/Config.js"
    },
    "./Finding": {
      "source": "./src/Finding.ts",
      "types": "./dist/src/Finding.d.ts",
      "default": "./dist/src/Finding.js"
    },
    "./ModuleSpecifier": {
      "source": "./src/ModuleSpecifier.ts",
      "types": "./dist/src/ModuleSpecifier.d.ts",
      "default": "./dist/src/ModuleSpecifier.js"
    },
    "./Pattern": {
      "source": "./src/Pattern.ts",
      "types": "./dist/src/Pattern.d.ts",
      "default": "./dist/src/Pattern.js"
    },
    "./ProjectId": {
      "source": "./src/ProjectId.ts",
      "types": "./dist/src/ProjectId.d.ts",
      "default": "./dist/src/ProjectId.js"
    },
    "./WorkspacePath": {
      "source": "./src/WorkspacePath.ts",
      "types": "./dist/src/WorkspacePath.d.ts",
      "default": "./dist/src/WorkspacePath.js"
    },
    "./Query": {
      "source": "./src/Query.ts",
      "types": "./dist/src/Query.d.ts",
      "default": "./dist/src/Query.js"
    },
    "./Recipe": {
      "source": "./src/Recipe.ts",
      "types": "./dist/src/Recipe.d.ts",
      "default": "./dist/src/Recipe.js"
    },
    "./Type": {
      "source": "./src/Type.ts",
      "types": "./dist/src/Type.d.ts",
      "default": "./dist/src/Type.js"
    },
    "./Workspace": {
      "source": "./src/Workspace/index.ts",
      "types": "./dist/src/Workspace/index.d.ts",
      "default": "./dist/src/Workspace/index.js"
    },
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./Proposal": {
      "source": "./src/Proposal.ts",
      "types": "./dist/src/Proposal.d.ts",
      "default": "./dist/src/Proposal.js"
    },
    "./Migration": {
      "source": "./src/Migration/index.ts",
      "types": "./dist/src/Migration/index.d.ts",
      "default": "./dist/src/Migration/index.js"
    }
  },
  "bin": {
    "safemods": "./dist/src/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "check": "pnpm fmt:check && pnpm typecheck && pnpm lint && pnpm test && pnpm package:check",
    "check:fast": "pnpm fmt:check && pnpm typecheck && pnpm lint",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && knip && pnpm safemods check",
    "prepare": "effect-tsgo patch --no-typescript --oxlint && node scripts/install-hooks.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mutation": "node scripts/mutation-check.ts",
    "package:check": "node scripts/check-package.ts",
    "verify": "pnpm check && pnpm coverage && pnpm mutation",
    "example": "node --conditions=source examples/run.ts",
    "safemods": "node --conditions=source src/bin.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@effect/platform-node-shared": "4.0.0-rc.109",
    "diff": "9.0.0",
    "effect": "4.0.0-rc.109",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.5",
    "@effect/vitest": "4.0.0-rc.109",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "dprint": "^0.57.4",
    "is-kit": "1.14.1",
    "knip": "^6.34.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  }
}
