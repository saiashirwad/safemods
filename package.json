{
  "name": "safemods",
  "version": "0.2.0",
  "description": "Type-directed codemods for TypeScript 7+ projects, built on Effect.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "safemods": "./dist/src/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "check": "pnpm check:fast && pnpm test",
    "check:fast": "node scripts/lint.ts --all",
    "check:file": "node scripts/check-files.ts",
    "check:release": "pnpm build && pnpm package:check",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.ts",
    "selfcheck": "node --conditions=source src/bin.ts check",
    "prepare": "node scripts/prepare.ts",
    "test": "vitest run",
    "test:fast": "vitest run --project fast",
    "test:changed": "vitest run --changed",
    "coverage": "vitest run --coverage",
    "mutation": "node scripts/mutation-check.ts",
    "package:check": "node scripts/check-package.ts",
    "verify": "pnpm check && pnpm coverage && pnpm mutation && pnpm check:release",
    "example": "node --conditions=source examples/run.ts",
    "safemods": "node --conditions=source src/bin.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "@effect/platform-node-shared": "4.0.0-rc.109",
    "diff": "9.0.0",
    "effect": "4.0.0-rc.109",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.5",
    "@effect/vitest": "4.0.0-rc.109",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "dprint": "^0.57.4",
    "is-kit": "1.14.1",
    "knip": "^6.34.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  }
}
