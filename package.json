{
  "name": "safemods",
  "version": "0.2.0",
  "description": "Type-directed codemods for TypeScript 7+ projects, built on Effect.",
  "bin": {
    "safemods": "./dist/src/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./Application": {
      "source": "./src/Application.ts",
      "types": "./dist/src/Application.d.ts",
      "default": "./dist/src/Application.js"
    },
    "./Check": {
      "source": "./src/Check.ts",
      "types": "./dist/src/Check.d.ts",
      "default": "./dist/src/Check.js"
    },
    "./Checks": {
      "source": "./src/Checks/index.ts",
      "types": "./dist/src/Checks/index.d.ts",
      "default": "./dist/src/Checks/index.js"
    },
    "./Draft": {
      "source": "./src/Draft.ts",
      "types": "./dist/src/Draft.d.ts",
      "default": "./dist/src/Draft.js"
    },
    "./ModuleSpecifier": {
      "source": "./src/ModuleSpecifier.ts",
      "types": "./dist/src/ModuleSpecifier.d.ts",
      "default": "./dist/src/ModuleSpecifier.js"
    },
    "./Pattern": {
      "source": "./src/Pattern.ts",
      "types": "./dist/src/Pattern.d.ts",
      "default": "./dist/src/Pattern.js"
    },
    "./Plan": {
      "source": "./src/Plan.ts",
      "types": "./dist/src/Plan.d.ts",
      "default": "./dist/src/Plan.js"
    },
    "./ProjectId": {
      "source": "./src/ProjectId.ts",
      "types": "./dist/src/ProjectId.d.ts",
      "default": "./dist/src/ProjectId.js"
    },
    "./ProjectRelativePath": {
      "source": "./src/ProjectRelativePath.ts",
      "types": "./dist/src/ProjectRelativePath.d.ts",
      "default": "./dist/src/ProjectRelativePath.js"
    },
    "./Query": {
      "source": "./src/Query.ts",
      "types": "./dist/src/Query.d.ts",
      "default": "./dist/src/Query.js"
    },
    "./Recipe": {
      "source": "./src/Recipe.ts",
      "types": "./dist/src/Recipe.d.ts",
      "default": "./dist/src/Recipe.js"
    },
    "./Type": {
      "source": "./src/Type.ts",
      "types": "./dist/src/Type.d.ts",
      "default": "./dist/src/Type.js"
    },
    "./Verification": {
      "source": "./src/Verification/index.ts",
      "types": "./dist/src/Verification/index.d.ts",
      "default": "./dist/src/Verification/index.js"
    },
    "./Workspace": {
      "source": "./src/Workspace/index.ts",
      "types": "./dist/src/Workspace/index.d.ts",
      "default": "./dist/src/Workspace/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "check": "pnpm fmt:check && pnpm typecheck && pnpm lint && pnpm test",
    "check:fast": "pnpm fmt:check && pnpm typecheck && pnpm lint",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && knip && pnpm safemods check",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "test": "vitest run",
    "example": "node --conditions=source examples/run.ts",
    "safemods": "node --conditions=source src/bin.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.109",
    "effect": "4.0.0-rc.109",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.5",
    "@effect/vitest": "4.0.0-rc.109",
    "@types/node": "26.2.0",
    "is-kit": "1.14.1",
    "knip": "^6.34.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
